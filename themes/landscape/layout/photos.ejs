<% if (page.photograph){ %>
  <%- partial('_partial/photograph') %>
<% } %>

<%- partial('_partial/nav-index-photos', { currentClass: "" }) %>

<h1 class="page-title" data-pagefind-meta="title" data-pagefind-meta="type:Page">
  Photos
</h1>

<div class="page-content">
  <%- page.content %>
</div>

<div class="cardset">
  <div class="cardview">
    <span class="cardcount"><%= page.items.length %></span>
    <span>photos</span>
    <%- partial('_partial/cardview/filter-status-photo') %>,
    <%- partial('_partial/cardview/presentation', { pagetype: "photos" }) %>,
    <%- partial('_partial/cardview/sort-photo') %>
  </div>

  <hr class="divider" />

  <div class="cards grid">
    <% for(var i=0; i < page.items.length; i++) { %>
      <%- partial('_partial/photo-item', { item: page.items[i] }) %>
    <% } %>
  </div>
</div>

<%- partial('_partial/cardview/common-script-photo') %>
<script>

  function setView() {
    setView_Status();
    setView_Presentation();
    setView_Sorting();
  }

  setTimeout(function() { //Hack for returning from external to page
    setView();
  }, 500)

</script>