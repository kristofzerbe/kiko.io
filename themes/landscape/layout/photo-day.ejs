<% if (page.photograph){ %>
  <%- partial('_partial/photograph') %>
<% } %>

<h1 class="page-title" data-pagefind-meta="title" data-pagefind-meta="type:Photo">
  Photo
  <small>of the Day</small>
</h1>

<div class="page-content h-entry">

  <%- page.content %>

  <hr class="divider" />

  <h2 class="section-heading <%= (page.photo.hasCustomName) ? "italic" : "" %>">
    <a href="/<%= config.photo_dir %>/<%= page.photo.key %>"><%= page.photo.name %></a>
  </h2>    

  <a href="/<%= config.photo_dir %>/<%= page.photo.key %>">
    <img id="photo" src="<%- page.photo.pathNormal %>" alt="<%- page.photo.name %>" />
  </a>

  <p class="small-info">
    Last update:&nbsp;&nbsp;<%= page.updated %>
    <br>
    Origin: <% if (page.origin === "Fotovorschlag") { %><a href="/photos/fotovorschlag/">#<%= page.origin %></a><% } else { %><%= page.origin %><% } %>
    <br>
    Previous photo:&nbsp;&nbsp;<a href="/<%= config.photo_dir %>/<%= page.prev?.key %>"><%= page.prev?.name %></a><br>
    <br>
  </p>
  

</div>

<script>
  window.addEventListener('load', () => {
    indicateSelectedPhotos();
  });
</script>