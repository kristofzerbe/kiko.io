<% syndication?.forEach(function(syn){ %>
  <% 
    let sitename = syn.site.charAt(0).toUpperCase() + syn.site.slice(1); // + ((syn.title) ? " (" + syn.title + ")" : "")
    let synname = sitename;
    if (syn.title) {
      synname += " (" + syn.title + ")";
    }
  %>
  <a class="syndication-link site-<%- syn.site?.toLowerCase() %> u-syndication" 
     href="<%- syn.url %>" rel="syndication" target="_blank"
     title="Syndication of this <%- type %> on <%- sitename %>">
    <% if (showText === true) { %>
      <span><%- synname %></span>
     <% } %>
  </a>
<% }); %>
