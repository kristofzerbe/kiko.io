<% if (page.photograph){ %>
  <%- partial('_partial/photograph') %>
<% } %>

<%- partial('_partial/nav-photos', { currentClass: "" }) %>

<h1 class="page-title">
  <small>Photos</small>
  More Stuff
</h1>

<div class="page-content">
  <%- page.content %>

  <hr class="divider" />

  <% for(var i=0; i < page.items.length; i++) { %>
    <section>
      <h2><a href="<%= page.items[i].permalink %>"><%= page.items[i].title %></a></h2>
      <p><%- page.items[i].content %></p>
    </section>
  <% } %>

</div>

<script>
  window.addEventListener('load', () => {
    indicateSelectedPhotos();
  });
</script>