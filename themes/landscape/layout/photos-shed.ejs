<% if (page.photograph){ %>
  <%- partial('_partial/photograph') %>
<% } %>

<%- partial('_partial/nav-photos', { currentClass: "" }) %>

<h1 class="page-title">
  <small>Photos</small>
  Shed
</h1>

<div class="page-content">
  <%- page.content %>
</div>

<div class="cardset">
  <div class="cardview">
    <span class="cardcount"><%= page.items.length %></span>
    <span>photos</span>
    <%- partial('_partial/cardview/filter-syndication-photo') %>
    <%- partial('_partial/cardview/presentation', { pagetype: "photos" }) %>
    <%- partial('_partial/cardview/sort-photo', { cookietype: "photos", order: "DESC" }) %>
  </div>

  <hr class="divider" />

  <div class="cards grid" data-long-press-delay="3000">
    <% for(var i=0; i < page.items.length; i++) { %>
      <%- partial('_partial/photo-item', { item: page.items[i] }) %>
    <% } %>
  </div>
</div>

<%- partial('_partial/cardview/common-script-photo') %>
<script>
  function setView() {
    setView_Syndication();
    setView_Presentation();
    setView_Sorting();
  }
  setTimeout(function() { //Hack for returning from external to page
    setView();
  }, 500)
</script>

<%- js('js/dist/long-press-event.min.js') %>
<script>
  window.addEventListener('load', () => {
    initPhotoSelection();
  });
</script>
